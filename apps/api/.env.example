# Copy to .env. The product name is read from here so it can change in one place.
PRODUCT_NAME=VakeelSevak
DATABASE_URL=postgresql+psycopg://vakeelsevak:vakeelsevak@localhost:5432/vakeelsevak
LANGUAGES=en,ml
DEFAULT_LANGUAGE=en
APP_ENV=development
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-not-for-production-0000
WEB_IDLE_MINUTES=30

# Providers. Leave as "fake" to run without keys.
AI_PROVIDER=fake            # fake | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SPEECH_PROVIDER=fake        # fake | google
OCR_PROVIDER=fake           # fake | google
GOOGLE_API_KEY=
# Email. Empty SMTP_HOST means messages are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vakeelsevak.example
UPLOAD_DIR=./uploads
PUBLIC_WEB_URL=http://localhost:5173
